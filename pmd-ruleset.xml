<?xml version="1.0"?>
<ruleset name="Custom Rules"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 
         https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    
    <description>
        厳格なPMDルールセット - 最高品質のコードを強制
    </description>
    
    <!-- Best Practices -->
    <rule ref="category/java/bestpractices.xml">
        <exclude name="JUnitTestContainsTooManyAsserts"/>
        <exclude name="JUnitAssertionsShouldIncludeMessage"/>
    </rule>
    
    <!-- Code Style -->
    <rule ref="category/java/codestyle.xml">
        <exclude name="OnlyOneReturn"/>
        <exclude name="AtLeastOneConstructor"/>
        <exclude name="LocalVariableCouldBeFinal"/>
        <exclude name="MethodArgumentCouldBeFinal"/>
    </rule>
    
    <rule ref="category/java/codestyle.xml/LongVariable">
        <properties>
            <property name="minimum" value="30"/>
        </properties>
    </rule>
    
    <rule ref="category/java/codestyle.xml/ShortVariable">
        <properties>
            <property name="minimum" value="2"/>
        </properties>
    </rule>
    
    <rule ref="category/java/codestyle.xml/ShortClassName">
        <properties>
            <property name="minimum" value="4"/>
        </properties>
    </rule>
    
    <rule ref="category/java/codestyle.xml/ShortMethodName">
        <properties>
            <property name="minimum" value="3"/>
        </properties>
    </rule>
    
    <!-- Design -->
    <rule ref="category/java/design.xml">
        <exclude name="LawOfDemeter"/>
        <exclude name="LoosePackageCoupling"/>
    </rule>
    
    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="methodReportLevel" value="10"/>
            <property name="classReportLevel" value="80"/>
        </properties>
    </rule>
    
    <rule ref="category/java/design.xml/NPathComplexity">
        <properties>
            <property name="reportLevel" value="200"/>
        </properties>
    </rule>
    
    <rule ref="category/java/design.xml/TooManyMethods">
        <properties>
            <property name="maxmethods" value="20"/>
        </properties>
    </rule>
    
    <rule ref="category/java/design.xml/TooManyFields">
        <properties>
            <property name="maxfields" value="15"/>
        </properties>
    </rule>
    
    <rule ref="category/java/design.xml/CouplingBetweenObjects">
        <properties>
            <property name="threshold" value="20"/>
        </properties>
    </rule>
    
    <rule ref="category/java/design.xml/ExcessiveImports">
        <properties>
            <property name="minimum" value="30"/>
        </properties>
    </rule>
    
    <!-- Documentation -->
    <rule ref="category/java/documentation.xml">
        <exclude name="CommentRequired"/>
    </rule>
    
    <rule ref="category/java/documentation.xml/CommentSize">
        <properties>
            <property name="maxLines" value="20"/>
            <property name="maxLineLength" value="120"/>
        </properties>
    </rule>
    
    <!-- Error Prone -->
    <rule ref="category/java/errorprone.xml">
        <exclude name="DataflowAnomalyAnalysis"/>
        <exclude name="BeanMembersShouldSerialize"/>
    </rule>
    
    <rule ref="category/java/errorprone.xml/AvoidDuplicateLiterals">
        <properties>
            <property name="maxDuplicateLiterals" value="3"/>
            <property name="minimumLength" value="3"/>
        </properties>
    </rule>
    
    <!-- Multithreading -->
    <rule ref="category/java/multithreading.xml"/>
    
    <!-- Performance -->
    <rule ref="category/java/performance.xml"/>
    
    <!-- Security -->
    <rule ref="category/java/security.xml"/>
    
    <!-- カスタムルール -->
    
    <!-- Null Safety -->
    <rule name="AvoidReturningNullFromMethods"
          language="java"
          message="メソッドからnullを返すことは避けてください。Optionalまたは空のコレクションを使用してください。"
          class="net.sourceforge.pmd.lang.rule.XPathRule">
        <priority>2</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//MethodDeclaration[not(ResultType/Type/PrimitiveType)]
//ReturnStatement/Expression/PrimaryExpression/PrimaryPrefix/Literal/NullLiteral
                ]]></value>
            </property>
        </properties>
    </rule>
    
    <!-- Complexity Rules -->
    <rule name="AvoidDeeplyNestedIfStmts"
          language="java"
          message="深くネストされたif文は避けてください（最大3レベル）"
          class="net.sourceforge.pmd.lang.rule.XPathRule">
        <priority>3</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//IfStatement[count(ancestor::IfStatement) >= 3]
                ]]></value>
            </property>
        </properties>
    </rule>
    
    <!-- Method Size -->
    <rule name="ExcessiveMethodLength"
          language="java"
          message="メソッドが長すぎます（最大50行）"
          class="net.sourceforge.pmd.lang.rule.XPathRule">
        <priority>3</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//MethodDeclaration[
    count(.//BlockStatement) > 50
]
                ]]></value>
            </property>
        </properties>
    </rule>
    
    <!-- Class Complexity -->
    <rule name="ExcessiveClassLength"
          language="java"
          message="クラスが長すぎます（最大500行）"
          class="net.sourceforge.pmd.lang.rule.XPathRule">
        <priority>3</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//ClassOrInterfaceDeclaration[
    count(.//BlockStatement) > 500
]
                ]]></value>
            </property>
        </properties>
    </rule>
    
    <!-- Parameter Count -->
    <rule name="ExcessiveParameterList"
          language="java"
          message="パラメータが多すぎます（最大5個）"
          class="net.sourceforge.pmd.lang.rule.XPathRule">
        <priority>3</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//MethodDeclaration[
    count(.//FormalParameter) > 5
]
                ]]></value>
            </property>
        </properties>
    </rule>
    
    <!-- Magic Numbers -->
    <rule name="AvoidMagicNumbers"
          language="java"
          message="マジックナンバーは定数として定義してください"
          class="net.sourceforge.pmd.lang.rule.XPathRule">
        <priority>3</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//Literal[not(parent::FieldDeclaration)]
[not(ancestor::Annotation)]
[@IntLiteral='true']
[not(@IntLiteral='0' or @IntLiteral='1' or @IntLiteral='-1' or @IntLiteral='2')]
                ]]></value>
            </property>
        </properties>
    </rule>
    
    <!-- Empty Catch Blocks -->
    <rule name="AvoidEmptyCatchBlocks"
          language="java"
          message="空のcatchブロックは避けてください"
          class="net.sourceforge.pmd.lang.rule.XPathRule">
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//CatchStatement[count(Block/BlockStatement) = 0]
                ]]></value>
            </property>
        </properties>
    </rule>
    
    <!-- String Concatenation in Loops -->
    <rule name="AvoidStringConcatenationInLoops"
          language="java"
          message="ループ内での文字列連結は避けてください。StringBuilderを使用してください"
          class="net.sourceforge.pmd.lang.rule.XPathRule">
        <priority>2</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//WhileStatement//AssignmentOperator[@Image='+=' and 
    ancestor::LocalVariableDeclaration/Type/ReferenceType/ClassOrInterfaceType[@Image='String']]
|
//ForStatement//AssignmentOperator[@Image='+=' and 
    ancestor::LocalVariableDeclaration/Type/ReferenceType/ClassOrInterfaceType[@Image='String']]
                ]]></value>
            </property>
        </properties>
    </rule>
</ruleset>