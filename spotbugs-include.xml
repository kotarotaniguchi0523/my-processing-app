<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- すべてのバグパターンを含める（最も厳格な設定） -->
    <Match>
        <Bug pattern="*"/>
    </Match>
    
    <!-- 特定のチェックを強制 -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
        <Priority value="1"/>
    </Match>
    
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH"/>
        <Priority value="1"/>
    </Match>
    
    <Match>
        <Bug pattern="NP_NULL_PARAM_DEREF"/>
        <Priority value="1"/>
    </Match>
    
    <!-- リソースリーク検出 -->
    <Match>
        <Bug pattern="OS_OPEN_STREAM"/>
        <Priority value="1"/>
    </Match>
    
    <Match>
        <Bug pattern="ODR_OPEN_DATABASE_RESOURCE"/>
        <Priority value="1"/>
    </Match>
    
    <!-- セキュリティ関連 -->
    <Match>
        <Bug pattern="SQL_INJECTION"/>
        <Priority value="1"/>
    </Match>
    
    <Match>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
        <Priority value="1"/>
    </Match>
    
    <Match>
        <Bug pattern="COMMAND_INJECTION"/>
        <Priority value="1"/>
    </Match>
    
    <!-- パフォーマンス -->
    <Match>
        <Bug pattern="DM_STRING_CTOR"/>
        <Priority value="2"/>
    </Match>
    
    <Match>
        <Bug pattern="DM_NUMBER_CTOR"/>
        <Priority value="2"/>
    </Match>
    
    <Match>
        <Bug pattern="DM_BOXED_PRIMITIVE_FOR_PARSING"/>
        <Priority value="2"/>
    </Match>
    
    <!-- 不正なコード -->
    <Match>
        <Bug pattern="IL_INFINITE_LOOP"/>
        <Priority value="1"/>
    </Match>
    
    <Match>
        <Bug pattern="IL_INFINITE_RECURSIVE_LOOP"/>
        <Priority value="1"/>
    </Match>
    
    <!-- 並行性の問題 -->
    <Match>
        <Bug pattern="AT_OPERATION_SEQUENCE_ON_CONCURRENT_ABSTRACTION"/>
        <Priority value="1"/>
    </Match>
    
    <Match>
        <Bug pattern="DC_DOUBLECHECK"/>
        <Priority value="1"/>
    </Match>
    
    <Match>
        <Bug pattern="DL_SYNCHRONIZATION_ON_BOOLEAN"/>
        <Priority value="1"/>
    </Match>
    
    <!-- コードの品質 -->
    <Match>
        <Bug pattern="BC_EQUALS_METHOD_SHOULD_WORK_FOR_ALL_OBJECTS"/>
        <Priority value="2"/>
    </Match>
    
    <Match>
        <Bug pattern="CN_IDIOM_NO_SUPER_CALL"/>
        <Priority value="2"/>
    </Match>
    
    <Match>
        <Bug pattern="DE_MIGHT_IGNORE"/>
        <Priority value="2"/>
    </Match>
    
    <!-- 国際化 -->
    <Match>
        <Bug pattern="DM_DEFAULT_ENCODING"/>
        <Priority value="2"/>
    </Match>
    
    <!-- マルチスレッド -->
    <Match>
        <Bug pattern="IS2_INCONSISTENT_SYNC"/>
        <Priority value="1"/>
    </Match>
    
    <Match>
        <Bug pattern="NN_NAKED_NOTIFY"/>
        <Priority value="1"/>
    </Match>
    
    <!-- 正確性 -->
    <Match>
        <Bug pattern="EC_UNRELATED_TYPES"/>
        <Priority value="1"/>
    </Match>
    
    <Match>
        <Bug pattern="EC_UNRELATED_CLASS_AND_INTERFACE"/>
        <Priority value="1"/>
    </Match>
    
    <Match>
        <Bug pattern="EC_UNRELATED_TYPES_USING_POINTER_EQUALITY"/>
        <Priority value="1"/>
    </Match>
    
    <!-- Finalizerの問題 -->
    <Match>
        <Bug pattern="FI_PUBLIC_SHOULD_BE_PROTECTED"/>
        <Priority value="2"/>
    </Match>
    
    <Match>
        <Bug pattern="FI_EMPTY"/>
        <Priority value="2"/>
    </Match>
    
    <!-- 悪いプラクティス -->
    <Match>
        <Bug pattern="SE_BAD_FIELD"/>
        <Priority value="2"/>
    </Match>
    
    <Match>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
        <Priority value="3"/>
    </Match>
</FindBugsFilter>